generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"     
  url      = env("DATABASE_URL")
}


model Review {
  id        String   @id @default(uuid())
  userId    String
  productId String
  rating    Int      @db.SmallInt
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}
