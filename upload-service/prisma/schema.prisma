generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model UploadLog {
  id        String   @id @default(uuid())
  userId    String?
  fileName  String
  fileType  String
  filePath  String
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}
